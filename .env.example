# =============================================================================
# SalesGrid — environment configuration (one application, one deployment)
# Copy to .env for local development. Never commit real values.
# =============================================================================

# --- Required ----------------------------------------------------------------
# PostgreSQL connection string (the existing production database is reused as-is).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/salesgrid?schema=public"

# Signs session tokens. Production: >= 32 random characters, no placeholder text.
# Reuse the legacy API's JWT_SECRET to keep existing mobile/API sessions valid after cut-over.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# --- Optional ----------------------------------------------------------------
PORT=3000
# Business timezone for "today", reports and day boundaries (server) and display (browser).
DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
# Where uploaded receipts/proofs are stored. Must be persistent storage in production.
UPLOAD_DIR=./uploads
# Comma-separated origins allowed to call the API cross-origin (not needed for the web app itself).
CORS_ORIGINS=
# Secure cookies default to on in production; set false only for plain-HTTP LAN testing.
# COOKIE_SECURE=false
# Rate limits per IP per 15 minutes.
# AUTH_RATE_LIMIT_MAX=30
# API_RATE_LIMIT_MAX=1000
# Show seeded demo accounts on the login page (development/demo only).
# SHOW_DEMO_LOGINS=true
# The seed refuses to run in production unless this is set explicitly.
# ALLOW_PRODUCTION_SEED=false
