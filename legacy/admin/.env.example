# ==============================================================================
# FieldTrack ERP — Admin Web Dashboard Environment Configuration
# ==============================================================================
# Service: admin (Next.js 14)
# Target Host Example: https://admin.example.com
# Port: 3001
#
# NOTE: Variables prefixed with NEXT_PUBLIC_ are bundled into client-side code
# and exposed to the browser. Do NOT put secrets or database keys here.
# ==============================================================================

# API Base URL (Public, Browser & Server)
# Used by Next.js rewrites and direct client fetches
# Local development: http://localhost:4000
# Production example: https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket / Realtime URL (Public, Browser)
# Used by Socket.IO client for live salesperson GPS tracking
# Falls back to NEXT_PUBLIC_API_URL if omitted
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Server-Side API URL for Next.js Rewrites (Private, Server-only)
# Optional: Set this if Next.js server communicates with the API over an internal network (e.g. Docker network, private VPC)
# API_URL=http://api:4000

# Development Server Port
PORT=3001
