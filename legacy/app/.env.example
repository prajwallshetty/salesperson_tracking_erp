# ==============================================================================
# FieldTrack ERP — Salesperson User App Environment Configuration
# ==============================================================================
# Service: app (React Native / Expo / Web SPA)
# Target Host Example: https://example.com (Web) or Mobile Device
#
# NOTE: Variables prefixed with EXPO_PUBLIC_ are bundled into client-side code
# and exposed to mobile/web clients. Do NOT put secrets or database keys here.
# ==============================================================================

# API Backend Base URL (Public, Client)
# Local web development: http://localhost:4000
# Android Emulator local testing: http://10.0.2.2:4000
# Physical Device local testing: http://YOUR_LAN_IP:4000 (e.g. http://192.168.1.100:4000)
# Production example: https://api.example.com
EXPO_PUBLIC_API_URL=http://localhost:4000

# Business Timezone Display Default
EXPO_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
