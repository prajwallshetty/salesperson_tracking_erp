{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": [
      "dom",
      "esnext"
    ],
    "jsx": "react-native",
    "strict": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@erp/shared": [
        "./src/shared/index.ts"
      ],
      "@erp/shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "extends": "expo/tsconfig.base"
}
