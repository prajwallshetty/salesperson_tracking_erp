{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@erp/database": ["./src/db/index.ts"],
      "@erp/database/*": ["./src/db/*"],
      "@erp/shared": ["./src/shared/index.ts"],
      "@erp/shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/**/*"]
}
