# ==============================================================================
# FieldTrack ERP — API Backend Environment Configuration
# ==============================================================================
# Service: api
# Target Host Example: https://api.example.com
# Port: 4000
#
# NOTE: All variables in this file are PRIVATE. Do not commit real values to git.
# ==============================================================================

# Database Connection (PostgreSQL with Prisma)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://grahithrao@localhost:5432/salesperson_erp_dev?schema=public"

# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Authentication (Required in production, minimum 32 characters)
JWT_SECRET=super-secret-salesperson-erp-key-2026-production-ready
JWT_EXPIRES_IN=7d

# CORS Allowed Frontend Origins (Comma-separated list)
# Include the exact protocol, domain, and port of user frontend (app) and admin dashboard (admin)
# Local development default: http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:19006
# Production example: https://example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:19006

# File Upload Directory (Relative or absolute path)
UPLOAD_DIR=./uploads

# Business Timezone
DEFAULT_TIMEZONE=Asia/Kolkata
