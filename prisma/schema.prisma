datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  MANAGER
  SALESPERSON
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SalespersonStatus {
  ACTIVE
  INACTIVE
  ON_DUTY
  OFF_DUTY
}

enum AssignmentType {
  PRIMARY
  BACKUP
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AttendanceStatus {
  ON_DUTY
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  ACTIVE
  ENDED
}

enum VisitOutcome {
  ORDER_TAKEN
  PAYMENT_COLLECTED
  FOLLOW_UP_REQUIRED
  NO_ORDER
  CLIENT_CLOSED
  OTHER
}

enum LedgerEntryType {
  OPENING_BALANCE
  INVOICE
  PAYMENT
  REVERSAL
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  phone        String      @unique
  passwordHash String
  role         Role        @default(SALESPERSON)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  salespersonProfile   Salesperson?
  managerPermissions   ManagerPermission?
  managedSalespersons  ManagerSalesperson[] @relation("ManagerRelation")
  auditLogs            AuditLog[]
  assignedClientsLog   ClientAssignment[]   @relation("AssignedByUser")
  verifiedPayments     Payment[]            @relation("PaymentVerifier")
  approvedOrders       Order[]              @relation("OrderApprover")
  accessCodes          UserAccessCode[]
  approvedExpenses     Expense[]            @relation("ExpenseApprover")
  rejectedExpenses     Expense[]            @relation("ExpenseRejecter")
  reimbursedExpenses   Expense[]            @relation("ExpenseReimburser")

  @@map("users")
}

model ManagerSalesperson {
  id            String   @id @default(uuid())
  managerId     String
  salespersonId String
  assignedAt    DateTime @default(now())

  manager       User     @relation("ManagerRelation", fields: [managerId], references: [id], onDelete: Cascade)
  salesperson   Salesperson @relation(fields: [salespersonId], references: [id], onDelete: Cascade)

  @@unique([managerId, salespersonId])
  @@map("manager_salespersons")
}

model ManagerPermission {
  id                  String   @id @default(uuid())
  userId              String   @unique
  canViewDashboard    Boolean  @default(true)
  canManageUsers      Boolean  @default(false)
  canManageProducts   Boolean  @default(true)
  canManageClients    Boolean  @default(true)
  canAssignClients    Boolean  @default(true)
  canViewGps          Boolean  @default(true)
  canViewOrders       Boolean  @default(true)
  canApproveOrders    Boolean  @default(true)
  canViewPayments     Boolean  @default(true)
  canVerifyPayments   Boolean  @default(true)
  canViewReports      Boolean  @default(true)
  canExportReports    Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("manager_permissions")
}

model Salesperson {
  id           String            @id @default(uuid())
  userId       String            @unique
  employeeCode String            @unique
  joiningDate  DateTime          @default(now())
  territory    String
  status       SalespersonStatus @default(OFF_DUTY)
  deviceId     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  managers           ManagerSalesperson[]
  clientAssignments  ClientAssignment[]
  orders             Order[]
  payments           Payment[]
  attendances        Attendance[]
  locationSessions   LocationSession[]
  locationPoints     LocationPoint[]
  visits             ClientVisit[]
  expenses           Expense[]

  @@index([employeeCode])
  @@index([status])
  @@map("salespersons")
}

model Client {
  id              String      @id @default(uuid())
  name            String
  businessName    String?
  contactPerson   String
  phone           String
  email           String?
  gstNumber       String?
  address         String
  city            String
  state           String
  pincode         String
  latitude        Float
  longitude       Float
  category        String      @default("General")
  creditLimit     Decimal     @default(0) @db.Decimal(12, 2)
  paymentTerms    String      @default("Net 30")
  status          String      @default("ACTIVE")
  notes           String?
  openingBalance  Decimal     @default(0) @db.Decimal(12, 2)
  currentOutstanding Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  assignments    ClientAssignment[]
  orders         Order[]
  payments       Payment[]
  visits         ClientVisit[]
  ledgerEntries  ClientLedgerEntry[]
  expenses       Expense[]

  @@index([city])
  @@index([status])
  @@index([phone])
  @@map("clients")
}

model ClientAssignment {
  id            String         @id @default(uuid())
  clientId      String
  salespersonId String
  assignedBy    String
  assignedAt    DateTime       @default(now())
  active        Boolean        @default(true)
  type          AssignmentType @default(PRIMARY)
  notes         String?

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  salesperson   Salesperson    @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  assignedUser  User           @relation("AssignedByUser", fields: [assignedBy], references: [id])

  @@index([clientId, active])
  @@index([salespersonId, active])
  @@map("client_assignments")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id           String      @id @default(uuid())
  sku          String      @unique
  barcode      String?     @unique
  name         String
  categoryId   String
  brand        String      @default("General")
  description  String?
  unit         String      @default("PCS")
  sellingPrice Decimal     @db.Decimal(10, 2)
  mrp          Decimal     @db.Decimal(10, 2)
  taxRate      Decimal     @default(18.0) @db.Decimal(5, 2)
  discount     Decimal     @default(0.0) @db.Decimal(5, 2)
  stock        Int         @default(0)
  minimumStock Int         @default(5)
  image        String?
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  category     Category    @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]

  @@index([sku])
  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique
  clientId       String
  salespersonId  String
  status         OrderStatus   @default(SUBMITTED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal       @db.Decimal(12, 2)
  notes          String?
  latitude       Float?
  longitude      Float?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client         Client        @relation(fields: [clientId], references: [id])
  salesperson    Salesperson   @relation(fields: [salespersonId], references: [id])
  approvedBy     User?         @relation("OrderApprover", fields: [approvedById], references: [id])
  items          OrderItem[]
  payments       Payment[]
  ledgerEntries  ClientLedgerEntry[]

  @@index([orderNumber])
  @@index([clientId])
  @@index([salespersonId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  productSku  String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  tax         Decimal  @default(0) @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(12, 2)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                   String        @id @default(uuid())
  receiptNumber        String        @unique
  clientId             String
  salespersonId        String
  orderId              String?
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod @default(CASH)
  transactionReference String?
  proofUrl             String?
  status               PaymentStatus @default(PENDING)
  collectedAt          DateTime      @default(now())
  verifiedAt           DateTime?
  verifiedById         String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  client               Client        @relation(fields: [clientId], references: [id])
  salesperson          Salesperson   @relation(fields: [salespersonId], references: [id])
  order                Order?        @relation(fields: [orderId], references: [id])
  verifiedBy           User?         @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  ledgerEntries        ClientLedgerEntry[]

  @@index([receiptNumber])
  @@index([clientId])
  @@index([salespersonId])
  @@index([status])
  @@index([collectedAt])
  @@map("payments")
}

model ClientLedgerEntry {
  id             String          @id @default(uuid())
  clientId       String
  orderId        String?
  paymentId      String?
  entryType      LedgerEntryType
  amount         Decimal         @db.Decimal(12, 2)
  runningBalance Decimal         @db.Decimal(12, 2)
  description    String
  timestamp      DateTime        @default(now())
  createdAt      DateTime        @default(now())

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order          Order?          @relation(fields: [orderId], references: [id])
  payment        Payment?        @relation(fields: [paymentId], references: [id])

  @@index([clientId, timestamp])
  @@map("client_ledger_entries")
}

model Attendance {
  id                String           @id @default(uuid())
  salespersonId     String
  date              DateTime         @db.Date
  loginAt           DateTime         @default(now())
  logoutAt          DateTime?
  loginLatitude     Float?
  loginLongitude    Float?
  logoutLatitude    Float?
  logoutLongitude   Float?
  workingMinutes    Int              @default(0)
  distanceTravelled Float            @default(0.0)
  status            AttendanceStatus @default(ON_DUTY)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  salesperson       Salesperson      @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  sessions          LocationSession[]
  expenses          Expense[]

  @@unique([salespersonId, date, status])
  @@index([salespersonId, date])
  @@map("attendance")
}

model LocationSession {
  id            String          @id @default(uuid())
  salespersonId String
  attendanceId  String
  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  status        SessionStatus   @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  salesperson   Salesperson     @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  attendance    Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  points        LocationPoint[]

  @@index([salespersonId, status])
  @@map("location_sessions")
}

model LocationPoint {
  id               String          @id @default(uuid())
  sessionId        String
  salespersonId    String
  latitude         Float
  longitude        Float
  accuracy         Float?
  speed            Float?
  heading          Float?
  batteryLevel     Float?
  networkType      String?
  deviceId         String?
  clientPointId    String?         @unique
  isFiltered       Boolean         @default(false)
  filterReason     String?
  serverReceivedAt DateTime        @default(now())
  timestamp        DateTime        @default(now())

  session       LocationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  salesperson   Salesperson     @relation(fields: [salespersonId], references: [id], onDelete: Cascade)

  @@index([salespersonId, timestamp])
  @@index([sessionId, timestamp])
  @@map("location_points")
}

model ClientVisit {
  id                 String       @id @default(uuid())
  clientId           String
  salespersonId      String
  startedAt          DateTime     @default(now())
  endedAt            DateTime?
  latitude           Float?
  longitude          Float?
  distanceFromClient Float?
  isException        Boolean      @default(false)
  exceptionReason    String?
  outcome            VisitOutcome @default(FOLLOW_UP_REQUIRED)
  notes              String?
  photoUrl           String?
  signatureUrl       String?
  voiceNoteUrl       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  client             Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  salesperson        Salesperson  @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  expenses           Expense[]

  @@index([clientId, startedAt])
  @@index([salespersonId, startedAt])
  @@map("client_visits")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  device    String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, recordId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String?
  role        Role?
  title       String
  message     String
  type        String   @default("INFO")
  read        Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([recipientId, read])
  @@index([role, createdAt])
  @@map("notifications")
}

model IdempotencyKey {
  id            String   @id @default(uuid())
  key           String   @unique
  endpoint      String
  salespersonId String?
  responseCode  Int
  responseBody  Json
  createdAt     DateTime @default(now())

  @@index([key])
  @@map("idempotency_keys")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

enum AccessCodeStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model UserAccessCode {
  id             String           @id @default(uuid())
  userId         String
  codeHash       String
  displayHint    String?
  status         AccessCodeStatus @default(ACTIVE)
  expiresAt      DateTime?
  failedAttempts Int              @default(0)
  lockedUntil    DateTime?
  lastUsedAt     DateTime?
  createdById    String?
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_access_codes")
}

enum ExpenseCategory {
  AUTO_RICKSHAW
  BUS_TRAIN_METRO_TAXI
  FUEL
  FOOD_MEALS
  ACCOMMODATION
  PARKING_TOLLS
  OTHER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

model Expense {
  id                  String          @id @default(uuid())
  expenseNumber       String          @unique
  salespersonId       String
  category            ExpenseCategory
  amount              Decimal         @db.Decimal(10, 2)
  currency            String          @default("INR")
  expenseDate         DateTime
  description         String
  businessPurpose     String?
  merchantName        String?
  paymentMethod       String          @default("CASH")
  receiptUrl          String?
  clientId            String?
  visitId             String?
  attendanceId        String?
  latitude            Float?
  longitude           Float?
  status              ExpenseStatus   @default(DRAFT)
  rejectionReason     String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  approvedBy          String?
  rejectedAt          DateTime?
  rejectedBy          String?
  reimbursedAt        DateTime?
  reimbursedBy        String?
  reimbursementRef    String?
  reimbursementMethod String?
  offlineId           String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  salesperson         Salesperson     @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  client              Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  visit               ClientVisit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  attendance          Attendance?     @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  approver            User?           @relation("ExpenseApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  rejecter            User?           @relation("ExpenseRejecter", fields: [rejectedBy], references: [id], onDelete: SetNull)
  reimburser          User?           @relation("ExpenseReimburser", fields: [reimbursedBy], references: [id], onDelete: SetNull)
  history             ExpenseHistory[]

  @@index([salespersonId, status])
  @@index([expenseDate])
  @@index([category])
  @@map("expenses")
}

model ExpenseHistory {
  id             String         @id @default(uuid())
  expenseId      String
  actorId        String?
  action         String
  previousStatus ExpenseStatus?
  newStatus      ExpenseStatus
  comment        String?
  snapshot       Json?
  createdAt      DateTime       @default(now())

  expense        Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId, createdAt])
  @@map("expense_histories")
}
