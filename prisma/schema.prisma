datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  MANAGER
  SALESPERSON
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SalespersonStatus {
  ACTIVE
  INACTIVE
  ON_DUTY
  OFF_DUTY
}

enum AssignmentType {
  PRIMARY
  BACKUP
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AttendanceStatus {
  ON_DUTY
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  ACTIVE
  ENDED
}

enum VisitOutcome {
  ORDER_TAKEN
  PAYMENT_COLLECTED
  FOLLOW_UP_REQUIRED
  NO_ORDER
  CLIENT_CLOSED
  OTHER
}

enum LedgerEntryType {
  OPENING_BALANCE
  INVOICE
  PAYMENT
  REVERSAL
}

model User {
  id           String     @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId     String     @default("00000000-0000-0000-0000-000000000001")
  name         String
  email        String
  phone        String
  passwordHash String
  role         Role       @default(SALESPERSON)
  status       UserStatus @default(ACTIVE)
  /// Incremented to invalidate every session token issued before (sign out everywhere).
  tokenVersion Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  salespersonProfile  Salesperson?
  managerPermissions  ManagerPermission?
  managedSalespersons ManagerSalesperson[] @relation("ManagerRelation")
  auditLogs           AuditLog[]
  assignedClientsLog  ClientAssignment[]   @relation("AssignedByUser")
  verifiedPayments    Payment[]            @relation("PaymentVerifier")
  approvedOrders      Order[]              @relation("OrderApprover")
  accessCodes         UserAccessCode[]
  approvedExpenses    Expense[]            @relation("ExpenseApprover")
  rejectedExpenses    Expense[]            @relation("ExpenseRejecter")
  reimbursedExpenses  Expense[]            @relation("ExpenseReimburser")
  uploadedFiles       UploadedFile[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("users")
}

model ManagerSalesperson {
  id            String   @id @default(uuid())
  managerId     String
  salespersonId String
  assignedAt    DateTime @default(now())

  manager     User        @relation("ManagerRelation", fields: [managerId], references: [id], onDelete: Cascade)
  salesperson Salesperson @relation(fields: [salespersonId], references: [id], onDelete: Cascade)

  @@unique([managerId, salespersonId])
  @@map("manager_salespersons")
}

model ManagerPermission {
  id                String   @id @default(uuid())
  userId            String   @unique
  canViewDashboard  Boolean  @default(true)
  canManageUsers    Boolean  @default(false)
  canManageProducts Boolean  @default(true)
  canManageClients  Boolean  @default(true)
  canAssignClients  Boolean  @default(true)
  canViewGps        Boolean  @default(true)
  canViewOrders     Boolean  @default(true)
  canApproveOrders  Boolean  @default(true)
  canViewPayments   Boolean  @default(true)
  canVerifyPayments Boolean  @default(true)
  canViewReports    Boolean  @default(true)
  canExportReports  Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("manager_permissions")
}

/// What the salesperson's device last reported about its own location capability. Reported by the
/// device (never inferred by the server); the admin console shows it next to the freshness of the
/// last real fix.
enum TrackingDeviceState {
  TRACKING
  PERMISSION_DENIED
  BACKGROUND_DENIED
  GPS_DISABLED
  STOPPED
}

model Salesperson {
  id              String               @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId        String               @default("00000000-0000-0000-0000-000000000001")
  userId          String               @unique
  employeeCode    String
  joiningDate     DateTime             @default(now())
  territory       String
  status          SalespersonStatus    @default(OFF_DUTY)
  deviceId        String?
  /// Last device-reported tracking capability and when/why (see TrackingDeviceState).
  trackingState   TrackingDeviceState?
  trackingStateAt DateTime?
  trackingDetail  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  managers          ManagerSalesperson[]
  clientAssignments ClientAssignment[]
  orders            Order[]
  payments          Payment[]
  attendances       Attendance[]
  locationSessions  LocationSession[]
  locationPoints    LocationPoint[]
  visits            ClientVisit[]
  expenses          Expense[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([employeeCode])
  @@index([status])
  @@map("salespersons")
}

model Client {
  id                 String   @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId           String   @default("00000000-0000-0000-0000-000000000001")
  name               String
  businessName       String?
  contactPerson      String
  phone              String
  email              String?
  gstNumber          String?
  address            String
  city               String
  state              String
  pincode            String
  latitude           Float
  longitude          Float
  category           String   @default("General")
  creditLimit        Decimal  @default(0) @db.Decimal(12, 2)
  paymentTerms       String   @default("Net 30")
  status             String   @default("ACTIVE")
  notes              String?
  openingBalance     Decimal  @default(0) @db.Decimal(12, 2)
  currentOutstanding Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignments   ClientAssignment[]
  orders        Order[]
  payments      Payment[]
  visits        ClientVisit[]
  ledgerEntries ClientLedgerEntry[]
  expenses      Expense[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([city])
  @@index([status])
  @@index([phone])
  @@map("clients")
}

model ClientAssignment {
  id            String         @id @default(uuid())
  clientId      String
  salespersonId String
  assignedBy    String
  assignedAt    DateTime       @default(now())
  active        Boolean        @default(true)
  type          AssignmentType @default(PRIMARY)
  notes         String?

  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  salesperson  Salesperson @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  assignedUser User        @relation("AssignedByUser", fields: [assignedBy], references: [id])

  @@index([clientId, active])
  @@index([salespersonId, active])
  @@map("client_assignments")
}

model Category {
  id          String   @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId    String   @default("00000000-0000-0000-0000-000000000001")
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id           String   @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId     String   @default("00000000-0000-0000-0000-000000000001")
  sku          String
  barcode      String?
  name         String
  categoryId   String
  brand        String   @default("General")
  description  String?
  unit         String   @default("PCS")
  sellingPrice Decimal  @db.Decimal(10, 2)
  mrp          Decimal  @db.Decimal(10, 2)
  taxRate      Decimal  @default(18.0) @db.Decimal(5, 2)
  discount     Decimal  @default(0.0) @db.Decimal(5, 2)
  stock        Int      @default(0)
  minimumStock Int      @default(5)
  image        String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([sku])
  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model Order {
  id             String      @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId       String      @default("00000000-0000-0000-0000-000000000001")
  orderNumber    String
  clientId       String
  salespersonId  String
  status         OrderStatus @default(SUBMITTED)
  subtotal       Decimal     @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  tax            Decimal     @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal     @db.Decimal(12, 2)
  notes          String?
  latitude       Float?
  longitude      Float?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  client        Client              @relation(fields: [clientId], references: [id])
  salesperson   Salesperson         @relation(fields: [salespersonId], references: [id])
  approvedBy    User?               @relation("OrderApprover", fields: [approvedById], references: [id])
  items         OrderItem[]
  payments      Payment[]
  ledgerEntries ClientLedgerEntry[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([orderNumber])
  @@index([clientId])
  @@index([salespersonId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String
  productSku  String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  tax         Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                   String        @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId             String        @default("00000000-0000-0000-0000-000000000001")
  receiptNumber        String
  clientId             String
  salespersonId        String
  orderId              String?
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod @default(CASH)
  transactionReference String?
  proofUrl             String?
  status               PaymentStatus @default(PENDING)
  collectedAt          DateTime      @default(now())
  verifiedAt           DateTime?
  verifiedById         String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  client        Client              @relation(fields: [clientId], references: [id])
  salesperson   Salesperson         @relation(fields: [salespersonId], references: [id])
  order         Order?              @relation(fields: [orderId], references: [id])
  verifiedBy    User?               @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  ledgerEntries ClientLedgerEntry[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([receiptNumber])
  @@index([clientId])
  @@index([salespersonId])
  @@index([status])
  @@index([collectedAt])
  @@map("payments")
}

model ClientLedgerEntry {
  id             String          @id @default(uuid())
  clientId       String
  orderId        String?
  paymentId      String?
  entryType      LedgerEntryType
  amount         Decimal         @db.Decimal(12, 2)
  runningBalance Decimal         @db.Decimal(12, 2)
  description    String
  timestamp      DateTime        @default(now())
  createdAt      DateTime        @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([clientId, timestamp])
  @@map("client_ledger_entries")
}

model Attendance {
  id                String           @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId          String           @default("00000000-0000-0000-0000-000000000001")
  salespersonId     String
  date              DateTime         @db.Date
  loginAt           DateTime         @default(now())
  logoutAt          DateTime?
  loginLatitude     Float?
  loginLongitude    Float?
  logoutLatitude    Float?
  logoutLongitude   Float?
  workingMinutes    Int              @default(0)
  distanceTravelled Float            @default(0.0)
  status            AttendanceStatus @default(ON_DUTY)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  salesperson Salesperson       @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  sessions    LocationSession[]
  expenses    Expense[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([salespersonId, date, status])
  @@index([tenantId])
  @@index([salespersonId, date])
  @@map("attendance")
}

model LocationSession {
  id            String        @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId      String        @default("00000000-0000-0000-0000-000000000001")
  salespersonId String
  attendanceId  String
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  status        SessionStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  salesperson Salesperson     @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  attendance  Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  points      LocationPoint[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([salespersonId, status])
  @@map("location_sessions")
}

model LocationPoint {
  id               String   @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId         String   @default("00000000-0000-0000-0000-000000000001")
  sessionId        String
  salespersonId    String
  latitude         Float
  longitude        Float
  accuracy         Float?
  speed            Float?
  heading          Float?
  batteryLevel     Float?
  networkType      String?
  deviceId         String?
  clientPointId    String?
  isFiltered       Boolean  @default(false)
  filterReason     String?
  serverReceivedAt DateTime @default(now())
  timestamp        DateTime @default(now())

  session     LocationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  salesperson Salesperson     @relation(fields: [salespersonId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, clientPointId])
  @@index([tenantId])
  @@index([salespersonId, timestamp])
  @@index([sessionId, timestamp])
  @@map("location_points")
}

model ClientVisit {
  id                 String       @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId           String       @default("00000000-0000-0000-0000-000000000001")
  clientId           String
  salespersonId      String
  startedAt          DateTime     @default(now())
  endedAt            DateTime?
  latitude           Float?
  longitude          Float?
  distanceFromClient Float?
  isException        Boolean      @default(false)
  exceptionReason    String?
  outcome            VisitOutcome @default(FOLLOW_UP_REQUIRED)
  notes              String?
  photoUrl           String?
  signatureUrl       String?
  voiceNoteUrl       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  salesperson Salesperson @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  expenses    Expense[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientId, startedAt])
  @@index([salespersonId, startedAt])
  @@map("client_visits")
}

model AuditLog {
  id        String   @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId  String   @default("00000000-0000-0000-0000-000000000001")
  userId    String?
  action    String
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  device    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([module, recordId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId    String   @default("00000000-0000-0000-0000-000000000001")
  recipientId String?
  role        Role?
  title       String
  message     String
  type        String   @default("INFO")
  read        Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([recipientId, read])
  @@index([role, createdAt])
  @@map("notifications")
}

model IdempotencyKey {
  id            String   @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId      String   @default("00000000-0000-0000-0000-000000000001")
  key           String
  endpoint      String
  salespersonId String?
  responseCode  Int
  responseBody  Json
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([key])
  @@map("idempotency_keys")
}

model SystemSetting {
  id          String   @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId    String   @default("00000000-0000-0000-0000-000000000001")
  key         String
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("system_settings")
}

enum AccessCodeStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model UserAccessCode {
  id             String           @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId       String           @default("00000000-0000-0000-0000-000000000001")
  userId         String
  codeHash       String
  displayHint    String?
  status         AccessCodeStatus @default(ACTIVE)
  expiresAt      DateTime?
  failedAttempts Int              @default(0)
  lockedUntil    DateTime?
  lastUsedAt     DateTime?
  createdById    String?
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId, status])
  @@map("user_access_codes")
}

enum ExpenseCategory {
  AUTO_RICKSHAW
  BUS_TRAIN_METRO_TAXI
  FUEL
  FOOD_MEALS
  ACCOMMODATION
  PARKING_TOLLS
  OTHER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

model Expense {
  id                  String          @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId            String          @default("00000000-0000-0000-0000-000000000001")
  expenseNumber       String
  salespersonId       String
  category            ExpenseCategory
  amount              Decimal         @db.Decimal(10, 2)
  currency            String          @default("INR")
  expenseDate         DateTime
  description         String
  businessPurpose     String?
  merchantName        String?
  paymentMethod       String          @default("CASH")
  receiptUrl          String?
  clientId            String?
  visitId             String?
  attendanceId        String?
  latitude            Float?
  longitude           Float?
  status              ExpenseStatus   @default(DRAFT)
  rejectionReason     String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  approvedBy          String?
  rejectedAt          DateTime?
  rejectedBy          String?
  reimbursedAt        DateTime?
  reimbursedBy        String?
  reimbursementRef    String?
  reimbursementMethod String?
  offlineId           String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  salesperson Salesperson      @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  visit       ClientVisit?     @relation(fields: [visitId], references: [id], onDelete: SetNull)
  attendance  Attendance?      @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  approver    User?            @relation("ExpenseApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  rejecter    User?            @relation("ExpenseRejecter", fields: [rejectedBy], references: [id], onDelete: SetNull)
  reimburser  User?            @relation("ExpenseReimburser", fields: [reimbursedBy], references: [id], onDelete: SetNull)
  history     ExpenseHistory[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, expenseNumber])
  @@unique([tenantId, offlineId])
  @@index([tenantId])
  @@index([salespersonId, status])
  @@index([expenseDate])
  @@index([category])
  @@map("expenses")
}

model ExpenseHistory {
  id             String         @id @default(uuid())
  expenseId      String
  actorId        String?
  action         String
  previousStatus ExpenseStatus?
  newStatus      ExpenseStatus
  comment        String?
  snapshot       Json?
  createdAt      DateTime       @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId, createdAt])
  @@map("expense_histories")
}

/// Ownership of files written by /api/files/upload (files uploaded before this table existed have no row).
model UploadedFile {
  id           String   @id @default(uuid())
  /// Owning company. Set and enforced by the tenant-scoped Prisma client (src/lib/db/tenancy.ts).
  tenantId     String   @default("00000000-0000-0000-0000-000000000001")
  filename     String   @unique
  uploadedById String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([uploadedById])
  @@map("uploaded_files")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// A company using SalesGrid. All business data belongs to exactly one tenant.
/// Existing single-company data is migrated into the default tenant (id ending ...0001).
model Tenant {
  id          String       @id @default(uuid())
  /// Company code entered at sign-in (lowercase letters, digits, hyphens).
  slug        String       @unique
  name        String
  status      TenantStatus @default(ACTIVE)
  /// Subscription end. Null = no expiry. After this moment users of the tenant cannot sign in or use the API.
  activeUntil DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users             User[]
  salespersons      Salesperson[]
  clients           Client[]
  categories        Category[]
  products          Product[]
  orders            Order[]
  payments          Payment[]
  expenses          Expense[]
  attendances       Attendance[]
  locationSessions  LocationSession[]
  locationPoints    LocationPoint[]
  clientVisits      ClientVisit[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  idempotencyKeys   IdempotencyKey[]
  systemSettings    SystemSetting[]
  userAccessCodes   UserAccessCode[]
  uploadedFiles     UploadedFile[]
  businessProfile   BusinessProfile?
  documentSequences DocumentSequence[]
  quotations        Quotation[]
  invoices          Invoice[]
  invoicePayments   InvoicePayment[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------------------------
// Quotations & invoices (additive: new tables and enums only)
// ---------------------------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  /// Superseded by a newer revision of the same quotation (kept for history).
  REVISED
}

/// OVERDUE is not stored: it is derived from dueDate for ISSUED / PARTIALLY_PAID invoices.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InvoicePaymentStatus {
  RECORDED
  VOIDED
}

/// NONE = no GST charged, INTRA = CGST + SGST (same state), INTER = IGST.
enum TaxMode {
  NONE
  INTRA
  INTER
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum DocumentKind {
  QUOTATION
  INVOICE
  RECEIPT
}

enum SequenceYearMode {
  NONE
  CALENDAR
  FISCAL
}

/// One row per company: the verified business details printed on quotations, invoices and receipts.
/// Nothing is pre-filled; the administrator enters the real values in Settings → Business details.
model BusinessProfile {
  id                    String   @id @default(uuid())
  tenantId              String   @unique @default("00000000-0000-0000-0000-000000000001")
  displayName           String   @default("Bharath Interior Decor")
  legalName             String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  phone                 String?
  email                 String?
  website               String?
  gstin                 String?
  pan                   String?
  /// GST is only charged when the business has confirmed it is registered.
  gstEnabled            Boolean  @default(false)
  defaultTaxRate        Decimal  @default(18) @db.Decimal(5, 2)
  roundTotal            Boolean  @default(true)
  currency              String   @default("INR")
  quotationValidityDays Int      @default(15)
  defaultPaymentTerms   String?
  invoiceDueDays        Int      @default(15)
  quotationNotes        String?
  quotationTerms        String?
  invoiceNotes          String?
  invoiceTerms          String?
  bankAccountName       String?
  bankName              String?
  bankAccountNumber     String?
  bankIfsc              String?
  bankBranch            String?
  upiId                 String?
  paymentInstructions   String?
  signatoryLabel        String?
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("business_profiles")
}

/// Configurable numbering: prefix + optional year token + zero-padded counter, e.g. INV-2026-27-0001.
model DocumentSequence {
  id         String           @id @default(uuid())
  tenantId   String           @default("00000000-0000-0000-0000-000000000001")
  kind       DocumentKind
  prefix     String
  padding    Int              @default(4)
  yearMode   SequenceYearMode @default(NONE)
  /// Year token the counter currently belongs to (resets when it changes).
  yearToken  String?
  nextNumber Int              @default(1)
  updatedAt  DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, kind])
  @@map("document_sequences")
}

model Quotation {
  id               String          @id @default(uuid())
  tenantId         String          @default("00000000-0000-0000-0000-000000000001")
  /// Shared by every revision of one quotation.
  groupId          String
  revision         Int             @default(1)
  number           String
  status           QuotationStatus @default(DRAFT)
  clientId         String?
  customerName     String
  customerPhone    String?
  customerEmail    String?
  customerAddress  String?
  customerGstin    String?
  customerState    String?
  quotationDate    DateTime        @db.Date
  validUntil       DateTime        @db.Date
  taxMode          TaxMode         @default(NONE)
  subtotal         Decimal         @default(0) @db.Decimal(12, 2)
  discountType     DiscountType    @default(AMOUNT)
  discountValue    Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal         @default(0) @db.Decimal(12, 2)
  shippingCharge   Decimal         @default(0) @db.Decimal(12, 2)
  otherCharges     Decimal         @default(0) @db.Decimal(12, 2)
  chargesTaxRate   Decimal         @default(0) @db.Decimal(5, 2)
  taxableAmount    Decimal         @default(0) @db.Decimal(12, 2)
  cgstAmount       Decimal         @default(0) @db.Decimal(12, 2)
  sgstAmount       Decimal         @default(0) @db.Decimal(12, 2)
  igstAmount       Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal         @default(0) @db.Decimal(12, 2)
  roundOff         Decimal         @default(0) @db.Decimal(12, 2)
  grandTotal       Decimal         @default(0) @db.Decimal(12, 2)
  paymentTerms     String?
  notes            String?
  terms            String?
  /// Business details as they were when the quotation was sent (so later settings changes do not rewrite it).
  businessSnapshot Json?
  sentAt           DateTime?
  respondedAt      DateTime?
  rejectionReason  String?
  revisionOfId     String?
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items    QuotationItem[]
  invoices Invoice[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, number, revision])
  @@index([tenantId])
  @@index([groupId])
  @@index([status])
  @@index([quotationDate])
  @@index([clientId])
  @@map("quotations")
}

model QuotationItem {
  id             String       @id @default(uuid())
  quotationId    String
  position       Int
  productId      String?
  description    String
  hsn            String?
  quantity       Decimal      @db.Decimal(12, 3)
  unit           String       @default("PCS")
  rate           Decimal      @db.Decimal(12, 2)
  discountType   DiscountType @default(PERCENT)
  discountValue  Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal      @default(0) @db.Decimal(12, 2)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2)
  cgstAmount     Decimal      @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal      @default(0) @db.Decimal(12, 2)
  igstAmount     Decimal      @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal      @default(0) @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model Invoice {
  id                String        @id @default(uuid())
  tenantId          String        @default("00000000-0000-0000-0000-000000000001")
  /// Assigned when the invoice is issued (drafts have none), so issued numbers are gapless.
  number            String?
  status            InvoiceStatus @default(DRAFT)
  clientId          String?
  quotationId       String?
  /// Set on a corrected copy: the invoice it replaces.
  correctsInvoiceId String?
  customerName      String
  customerPhone     String?
  customerEmail     String?
  customerAddress   String?
  customerGstin     String?
  customerState     String?
  invoiceDate       DateTime      @db.Date
  dueDate           DateTime      @db.Date
  taxMode           TaxMode       @default(NONE)
  subtotal          Decimal       @default(0) @db.Decimal(12, 2)
  discountType      DiscountType  @default(AMOUNT)
  discountValue     Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  shippingCharge    Decimal       @default(0) @db.Decimal(12, 2)
  otherCharges      Decimal       @default(0) @db.Decimal(12, 2)
  chargesTaxRate    Decimal       @default(0) @db.Decimal(5, 2)
  taxableAmount     Decimal       @default(0) @db.Decimal(12, 2)
  cgstAmount        Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount        Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount        Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal       @default(0) @db.Decimal(12, 2)
  roundOff          Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal       @default(0) @db.Decimal(12, 2)
  /// Sum of RECORDED payments; maintained in the same transaction that records or voids a payment.
  amountPaid        Decimal       @default(0) @db.Decimal(12, 2)
  paymentTerms      String?
  notes             String?
  terms             String?
  /// Business details frozen at issue time.
  businessSnapshot  Json?
  issuedAt          DateTime?
  issuedById        String?
  cancelledAt       DateTime?
  cancelledById     String?
  cancelReason      String?
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items     InvoiceItem[]
  payments  InvoicePayment[]
  quotation Quotation?       @relation(fields: [quotationId], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceDate])
  @@index([clientId])
  @@index([quotationId])
  @@map("invoices")
}

model InvoiceItem {
  id             String       @id @default(uuid())
  invoiceId      String
  position       Int
  productId      String?
  description    String
  hsn            String?
  quantity       Decimal      @db.Decimal(12, 3)
  unit           String       @default("PCS")
  rate           Decimal      @db.Decimal(12, 2)
  discountType   DiscountType @default(PERCENT)
  discountValue  Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal      @default(0) @db.Decimal(12, 2)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2)
  cgstAmount     Decimal      @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal      @default(0) @db.Decimal(12, 2)
  igstAmount     Decimal      @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal      @default(0) @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoicePayment {
  id             String               @id @default(uuid())
  tenantId       String               @default("00000000-0000-0000-0000-000000000001")
  invoiceId      String
  receiptNumber  String
  amount         Decimal              @db.Decimal(12, 2)
  paidOn         DateTime             @db.Date
  method         PaymentMethod        @default(CASH)
  reference      String?
  notes          String?
  status         InvoicePaymentStatus @default(RECORDED)
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  /// Client-generated key: submitting the same payment twice records it once.
  idempotencyKey String
  createdById    String?
  createdAt      DateTime             @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_payments")
}
